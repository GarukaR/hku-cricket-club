# Everything the CMS needs from outside itself. Copy to `apps/cms/.env` to run
# `npm run dev --workspace @hkucc/cms` against your own Neon branch and R2
# bucket — or skip all of it and run `docker compose up`, which supplies its own
# local stand-ins and needs no account anywhere.
#
# Every one of these is required. There are no defaults, on purpose: the
# container is meant to hold no state, and a value that quietly falls back to
# something local is how that stops being true. apps/cms/src/lib/env.ts checks
# them at start-up and names all the missing ones at once.
#
# Nothing here is committed. `.env*` is gitignored and .dockerignore'd.

# --- Neon ---------------------------------------------------------------------
# Neon → your project → Connection string. Use the pooled one; a container that
# sleeps and wakes opens connections in bursts.
DATABASE_URL=postgres://user:password@ep-something.ap-southeast-1.aws.neon.tech/hkucc?sslmode=require

# --- Payload ------------------------------------------------------------------
# Payload derives its encryption key from this. At least 64 characters:
#   openssl rand -hex 32
# Changing it invalidates every existing session and every encrypted field.
PAYLOAD_SECRET=

# Where the admin panel is reachable. On Render this is the service's own URL;
# locally, http://localhost:3001.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# --- Cloudflare R2 ------------------------------------------------------------
R2_BUCKET=hkucc-media

# Where uploads are *written*. Cloudflare → R2 → your bucket → Settings → S3 API.
# The origin only — no bucket name on the end; the bucket is a path segment.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Where uploads are *read*, by a browser, from the public site. Either the
# bucket's r2.dev URL or a custom domain in front of it. A different host from
# R2_ENDPOINT on purpose — see "Reading the site never wakes the CMS" in
# docs/cms.md.
R2_PUBLIC_URL=https://media.hkucricketclub.example

# Cloudflare → R2 → Manage API tokens → Object Read & Write, scoped to the one
# bucket. The secret is shown once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
