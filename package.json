{
  "name": "hku-cricket-club",
  "version": "0.1.0",
  "private": true,
  "description": "Official website of the Hong Kong University Cricket Club",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hkucc/web",
    "build": "npm run build --workspace @hkucc/web",
    "start": "npm run start --workspace @hkucc/web",
    "dev:cms": "npm run dev --workspace @hkucc/cms",
    "build:cms": "npm run build --workspace @hkucc/cms",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "assert:prerendered": "npm run assert:prerendered --workspaces --if-present",
    "tokens": "node design/derive.js --css > apps/web/src/app/tokens.css"
  }
}
