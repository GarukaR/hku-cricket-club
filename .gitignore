# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies. Not root-anchored: npm hoists to the root store but still writes
# a node_modules inside a workspace whenever a version cannot be hoisted.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/apps/*/coverage

# next.js. Every workspace builds into its own directory.
.next/
/out/
/apps/*/out/

# production
/build
/apps/*/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is the exception: it names every variable the CMS requires and
# carries no value for any of them.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent skills. The payload lives in .agents/skills/ and is committed, along
# with skills-lock.json. .claude/skills/ is only a set of absolute symlinks
# into it, generated by the installer — machine-specific, and broken on any
# other checkout path.
/.claude/skills/
